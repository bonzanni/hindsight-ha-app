-            LocalSTCrossEncoder._executor,
-            self._predict_sync,
-            pairs,
-        )
+        with LocalSTCrossEncoder._pending_lock:
+            LocalSTCrossEncoder._pending_jobs_count += 1
+        try:
+            submitted = LocalSTCrossEncoder._executor.submit(self._predict_sync, pairs)
+        except BaseException:
+            # Submission failed: no job was queued, release immediately.
+            with LocalSTCrossEncoder._pending_lock:
+                LocalSTCrossEncoder._pending_jobs_count -= 1
+            raise
+        # Awaiter cancellation (e.g. the recall handler deadline) propagates
+        # through wrap_future to Future.cancel(): a still-queued job is
+        # cancelled (done-callback fires, slot released); a started thread
+        # keeps running and its slot is held until the thread finishes.
+        submitted.add_done_callback(LocalSTCrossEncoder._release_pending_slot)
+        return await asyncio.wrap_future(submitted)
 
 
