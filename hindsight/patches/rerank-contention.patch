+    # Occupancy of the shared executor lane: jobs submitted and not yet
+    # finished (running + queued), INCLUDING work whose awaiter was cancelled
+    # but whose thread is still burning CPU (a started thread cannot be
+    # cancelled). Incremented on submit in the event loop, released by a
+    # done-callback on the concurrent future — in the worker thread for jobs
+    # that ran, or in the cancelling thread for jobs cancelled while still
+    # queued — so doomed work stays visible to callers that use
+    # pending_jobs() for load-shedding decisions and a cancelled queued job
+    # cannot leak the count.
+    _pending_lock = threading.Lock()
+    _pending_jobs_count: int = 0
+
+    @classmethod
+    def pending_jobs(cls) -> int:
+        """Rerank jobs submitted to the shared executor and not yet finished."""
+        with cls._pending_lock:
+            return cls._pending_jobs_count
