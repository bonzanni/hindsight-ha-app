+            # after restart, so a short drain keeps container stop well under
+            # the supervisor kill grace instead of eating it all (exit 137).
+            await poller.shutdown_graceful(
+                timeout=float(os.getenv("HINDSIGHT_API_WORKER_SHUTDOWN_TIMEOUT", "30"))
+            )
             if poller_task is not None:
