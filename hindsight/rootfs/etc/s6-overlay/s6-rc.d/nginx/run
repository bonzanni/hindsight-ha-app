#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# nginx ingress front for the Hindsight control-plane (listens on ingress_port).
# ==============================================================================
bashio::log.info "Starting nginx ingress front on :8099..."
# Absolute path: nginx ships in /usr/sbin (not on the venv-prefixed PATH).
exec /usr/sbin/nginx -c /etc/nginx/hindsight-ingress.conf -g "daemon off;"
